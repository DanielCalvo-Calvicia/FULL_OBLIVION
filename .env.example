# FULL_OBLIVION Docker Compose environment.
# Copy to .env and edit before running Docker Compose.

APP_ENV=development

# Host port mappings. Change these when another local project uses the defaults.
BRAIN_PORT=7999
MICROPHONE_PORT=8000
STT_PORT=8001
TTS_PORT=8002
SPEAKER_PORT=8003

# Brain dependency URLs.
# Defaults use Docker Compose service DNS for same-host container deployment.
# For distributed hosts, replace these with LAN-reachable URLs, for example:
# MICROPHONE_BASE_URL=http://192.168.1.20:8000
# STT_BASE_URL=http://192.168.1.30:8001
# TTS_BASE_URL=http://192.168.1.30:8002
# SPEAKER_BASE_URL=http://192.168.1.31:8003
MICROPHONE_BASE_URL=http://microphone:8000
STT_BASE_URL=http://stt:8001
TTS_BASE_URL=http://tts:8002
SPEAKER_BASE_URL=http://speaker:8003

# OpenAI-backed STT/TTS. Required when STT_ENGINE=openai or TTS_ADAPTER=openai.
OPENAI_API_KEY=

# STT options.
STT_ENGINE=openai
AUTOLOAD_VOICE_STREAM_URL=

# TTS options.
TTS_ADAPTER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_RESPONSE_FORMAT=wav
OPENAI_TTS_INSTRUCTIONS=
OPENAI_TTS_SPEED=
TTS_SPEECH_RATE=140
TTS_VOICE_NAME=

# Speaker options.
SPEAKER_DEVICE_INDEX=
SPEAKER_DEVICE_KEYWORDS=default
AUTOLOAD_STREAM_URL=
ALLOWED_ORIGINS=*

# Brain startup checks.
STARTUP_PREFLIGHT_ENABLED=true
STARTUP_PREFLIGHT_TIMEOUT_SECONDS=120
MICROSERVICE_READY_POLL_INTERVAL_SECONDS=3

# Optional Linux audio passthrough values when uncommenting compose blocks.
HOST_UID=1000
PULSE_COOKIE=/home/user/.config/pulse/cookie
