# FULL_OBLIVION root environment template.
# Copy to .env and fill values. Docker Compose maps these service-scoped
# source vars into each container using the original project env var names.

BRAIN_HOST_PORT=7999
MICROPHONE_HOST_PORT=8000
STT_HOST_PORT=8001
TTS_HOST_PORT=8002
SPEAKER_HOST_PORT=8003

BRAIN_APP_ENV=development
BRAIN_VSCODE_ENV=
BRAIN_VSCODE_LAUNCH_PROFILE=
BRAIN_SERVICE_HOST=0.0.0.0
BRAIN_SERVICE_PORT=7999
BRAIN_PROVIDER_NAME=local
BRAIN_PROVIDER_TIMEOUT_SECONDS=30
BRAIN_PROVIDER_API_KEY=
BRAIN_MICROPHONE_BASE_URL=http://microphone:8000
BRAIN_MICROPHONE_STREAM_ENDPOINT=/stream
BRAIN_MICROPHONE_START_ENDPOINT=/start
BRAIN_MICROPHONE_STOP_ENDPOINT=/stop
BRAIN_STT_BASE_URL=http://stt:8001
BRAIN_STT_SET_STREAM_ENDPOINT=/process/stream/set
BRAIN_STT_GET_STREAM_ENDPOINT=/process/stream/get
BRAIN_STT_BATCH_ENDPOINT=/process/batch
BRAIN_TTS_BASE_URL=http://tts:8002
BRAIN_TTS_SET_STREAM_ENDPOINT=/process/stream/set
BRAIN_TTS_STREAM_ENDPOINT=/process/stream/get
BRAIN_SPEAKER_BASE_URL=http://speaker:8003
BRAIN_SPEAKER_PLAY_STREAM_ENDPOINT=/process/stream/set
BRAIN_SPEAKER_STREAM_ENDPOINT=
BRAIN_STARTUP_PREFLIGHT_ENABLED=true
BRAIN_STARTUP_PREFLIGHT_TIMEOUT_SECONDS=60
BRAIN_MICROSERVICE_READY_POLL_INTERVAL_SECONDS=2
BRAIN_RUN_LIVE_MICROSERVICE_TESTS=0

MICROPHONE_APP_ENV=development
MICROPHONE_VSCODE_ENV=development
MICROPHONE_VSCODE_LAUNCH_PROFILE="Python: Run (development env)"
MICROPHONE_LOG_LEVEL=TRACE

SPEAKER_VSCODE_ENV=
SPEAKER_VSCODE_LAUNCH_PROFILE=
SPEAKER_APP_ENV=development
SPEAKER_SERVICE_HOST=0.0.0.0
SPEAKER_SERVICE_PORT=8003
SPEAKER_DEVICE_INDEX=
SPEAKER_DEVICE_KEYWORDS=i2s,hw,default,sysdefault
SPEAKER_ALLOWED_ORIGINS=*
SPEAKER_AUTOLOAD_STREAM_URL=

STT_APP_ENV=debug
STT_VSCODE_ENV=development
STT_SERVICE_HOST=0.0.0.0
STT_SERVICE_PORT=8001
STT_ENGINE=openai
STT_LANGUAGE=es
STT_OPENAI_API_KEY=
STT_AUTOLOAD_VOICE_STREAM_URL=

TTS_APP_ENV=development
TTS_VSCODE_ENV=
TTS_VSCODE_LAUNCH_PROFILE=
TTS_SERVICE_HOST=0.0.0.0
TTS_SERVICE_PORT=8002
TTS_ADAPTER=openai
TTS_SPEECH_RATE=140
TTS_VOICE_NAME=Zira
TTS_OPENAI_API_KEY=
TTS_OPENAI_TTS_MODEL=gpt-4o-mini-tts
TTS_OPENAI_TTS_VOICE=alloy
TTS_OPENAI_TTS_RESPONSE_FORMAT=wav
TTS_OPENAI_TTS_INSTRUCTIONS=
TTS_OPENAI_TTS_SPEED=
TTS_OPENAI_BASE_URL=https://api.openai.com/v1
TTS_TEST_BASE_URL=http://127.0.0.1:8002
