# Deployment state and machine-specific configuration never go to git
hosts/*.toml
!hosts/*.example.toml
secrets/*
__pycache__/
*.pyc
.pytest_cache/

# Never commit environment files (generated .env, old root .env)
.env
*.env

# The single file of truth of the robot: your addresses, settings and keys (copy robot.example.toml)
/robot.toml
