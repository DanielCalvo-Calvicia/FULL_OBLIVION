# Your robot is yours: which layout it uses, your keys and settings, what is particular to each of your machines.
# The ready-made layouts (config/layouts/), the default settings of every service (config/services/) and the *.example.toml
# templates are committed.
/config/robot.toml
/config/local/*
!/config/local/*.example.toml
!/config/local/README.md
/config/machines/*.toml
!/config/machines/*.example.toml

# Deployment state never goes to git
__pycache__/
*.pyc
.pytest_cache/

# Never commit environment files (generated .env, old root .env)
.env
*.env
