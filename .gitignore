# Deployment state and machine-specific configuration never go to git
hosts/*.toml
!hosts/*.example.toml
secrets/*
!secrets/example.env
__pycache__/
*.pyc
.pytest_cache/
# Old cloned copies of the service repos (unused by the current tool)
repos/

# Never commit environment files (generated .env, old root .env)
.env
*.env
!secrets/example.env
