# Secrets of ONE machine: copy to secrets/<host>.env (git-ignored) and point [host] secrets at it.
# Format: <SERVICE>__<VARIABLE>=value   (two underscores; only these lines are read; service names in
# upper case, "-" written as "_": ai-agent -> AI_AGENT__).
# Fill only what you use. Never commit the real file, never paste values into docs, tickets or chats.

# --- stt: needed when STT_ENGINE=openai (the default). Not needed with STT_ENGINE=local ---
STT__OPENAI_API_KEY=

# --- ai-agent: LLM providers. The active profile in ai-agent/config/step_models.json ("budget50_groq")
# uses Groq for the planning steps and Google for the small ones, so it needs both keys.
# ai-agent stays "not available" (its /available reports is_available=false) until at least one key is set. ---
AI_AGENT__GROQ_API_KEY=
AI_AGENT__GOOGLE_API_KEY=
# Only if you switch profile/models to these providers:
# AI_AGENT__OPENAI_API_KEY=
# AI_AGENT__ANTHROPIC_API_KEY=
# AI_AGENT__MISTRAL_API_KEY=
# AI_AGENT__COHERE_API_KEY=
# AI_AGENT__GITHUB_PAT=
# Optional cost tracking (Langfuse); only metadata is sent, never prompts or answers:
# AI_AGENT__LANGFUSE_PUBLIC_KEY=
# AI_AGENT__LANGFUSE_SECRET_KEY=
