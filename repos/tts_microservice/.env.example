# Runtime environment: development, staging, or production.
APP_ENV=development

# Optional highest-precedence environment override.
VSCODE_ENV=

# Optional VS Code launch profile name used to select an env file.
VSCODE_LAUNCH_PROFILE=

# HTTP server bind settings.
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8002

# TTS backend: pyttsx3 or openai.
TTS_ADAPTER=pyttsx3
TTS_SPEECH_RATE=140
TTS_VOICE_NAME=Zira

# OpenAI TTS settings. OPENAI_API_KEY is required only when TTS_ADAPTER=openai.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_RESPONSE_FORMAT=wav
OPENAI_TTS_INSTRUCTIONS=
OPENAI_TTS_SPEED=
OPENAI_BASE_URL=https://api.openai.com/v1

# End-to-end test target.
TTS_TEST_BASE_URL=http://127.0.0.1:8002
