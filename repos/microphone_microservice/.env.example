# Runtime environment: development, staging, or production.
# Supported aliases include dev/debug/local, stage, and prod.
APP_ENV=development

# Compatibility environment key recognized by the runtime resolver.
VSCODE_ENV=development

# Optional VS Code launch profile selector.
VSCODE_LAUNCH_PROFILE="Python: Run (development env)"

# Included for readability; the custom logger currently derives its threshold
# from APP_ENV rather than reading LOG_LEVEL directly.
LOG_LEVEL=TRACE
